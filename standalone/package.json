{
  "name": "plugin-backup-standalone",
  "private": true,
  "description": "Runs this plugin's tests and typecheck outside a p0code checkout.",
  "type": "module",
  "scripts": {
    "postinstall": "node link-node-modules.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/tsgo": "0.67.1",
    "@types/node": "26.6.10",
    "effect": "4.1.5",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@effect/tsgo"
    ]
  }
}
